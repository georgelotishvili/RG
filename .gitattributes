# Keep all detected text byte-stable across platforms. Binary files remain binary.
* text=auto eol=lf

# Exact research and publication formats must always use LF.
*.bib text eol=lf
*.dat text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sha256 text eol=lf
*.tex text eol=lf
*.txt text eol=lf

# Never subject binary publication assets to text normalization.
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
