\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Operational readout of an oscillon within a pressure-deficit zone.} \textbf  {(A)} In an unperturbed, high-pressure foundation-medium, an oscillon resides in a dense nodal network; inter-node coupling is robust and local processes proceed at maximal cadence. \textbf  {(B)} Within a pressure-deficit zone, substrate nodes are rarefied; operational inter-node distance increases, transmission rates decrease, and local temporal passage decelerates. \textbf  {(C)} In external readout, an oscillon in a pressure deficit is registered with a slowed clock rate, contracted operational size, and shifted effective mass, while the internal separation does not enter as an independent direct observable.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:figure_3_v2}{{1}{14}{\textbf {Operational readout of an oscillon within a pressure-deficit zone.} \textbf {(A)} In an unperturbed, high-pressure foundation-medium, an oscillon resides in a dense nodal network; inter-node coupling is robust and local processes proceed at maximal cadence. \textbf {(B)} Within a pressure-deficit zone, substrate nodes are rarefied; operational inter-node distance increases, transmission rates decrease, and local temporal passage decelerates. \textbf {(C)} In external readout, an oscillon in a pressure deficit is registered with a slowed clock rate, contracted operational size, and shifted effective mass, while the internal separation does not enter as an independent direct observable}{figure.1}{}}
