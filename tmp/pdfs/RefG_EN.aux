\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Radial Acceleration Relation comparison with SPARC data.} The observed radial acceleration $g_{\rm  obs}=V_{\rm  obs}^2/R$ versus the baryonic acceleration $g_{\rm  bar}$ for 2,788 selected points across 163 disk galaxies. With fixed $a_0$ and mass-to-light ratios, but no galaxy-specific fitting, the algebraic $\mathrm  {RefG}$ curve obtained from $W(g_v,g_N)$ gives an RMS scatter of $0.141\text  { dex}$ and a mean residual of $-0.012\text  { dex}$.}}{22}{figure.2}\protected@file@percent }
\newlabel{fig:sparc_rar}{{2}{22}{\textbf {Radial Acceleration Relation comparison with SPARC data.} The observed radial acceleration $g_{\rm obs}=V_{\rm obs}^2/R$ versus the baryonic acceleration $g_{\rm bar}$ for 2,788 selected points across 163 disk galaxies. With fixed $a_0$ and mass-to-light ratios, but no galaxy-specific fitting, the algebraic $\RefG $ curve obtained from $W(g_v,g_N)$ gives an RMS scatter of $0.141\text { dex}$ and a mean residual of $-0.012\text { dex}$}{figure.2}{}}
